{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEL_REPO=\"$CLAUDE_PROJECT_DIR\" node \"$CLAUDE_PROJECT_DIR/dist/index.js\" prompt-context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KEEL_REPO=\"$CLAUDE_PROJECT_DIR\" node \"$CLAUDE_PROJECT_DIR/dist/index.js\" verdict --hook"
          }
        ]
      }
    ]
  }
}
