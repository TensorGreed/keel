{
  "name": "@tensorgreed/keel",
  "version": "0.1.3",
  "description": "Development intelligence layer: your codebase, with memory and foresight. MCP server for coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "keel": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "recipes",
    "docs/concept.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TensorGreed/keel.git"
  },
  "homepage": "https://github.com/TensorGreed/keel#readme",
  "bugs": {
    "url": "https://github.com/TensorGreed/keel/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "developer-tools",
    "code-intelligence",
    "dependency-graph",
    "static-analysis",
    "test-selection",
    "ai-agents",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsc && node scripts/copy-assets.mjs && node dist/index.js",
    "test": "vitest run",
    "test:coldstart": "vitest run --config vitest.ci.config.ts test/ci/coldstart.test.ts",
    "test:perf": "vitest run --config vitest.ci.config.ts test/ci/perf.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "typescript": "^5.5.0",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "vitest": "^3.0.0"
  }
}
